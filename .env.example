# SQL Server Connection Configuration

# Required - SQL Server credentials
SQLSERVER_USER=your-username
SQLSERVER_PASSWORD=your-password

# Server connection details
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=master

# Security settings
SQLSERVER_ENCRYPT=true
# Set to true only for local dev or servers with self-signed certs — never for production
SQLSERVER_TRUST_CERT=false

# Performance settings
SQLSERVER_CONNECTION_TIMEOUT=30000
SQLSERVER_REQUEST_TIMEOUT=60000
SQLSERVER_MAX_ROWS=1000

# Example configurations for different environments:

# Azure SQL Database
# SQLSERVER_HOST=your-server.database.windows.net
# SQLSERVER_ENCRYPT=true
# SQLSERVER_TRUST_CERT=false

# On-premises SQL Server with self-signed certificates
# SQLSERVER_HOST=sql-server.company.com
# SQLSERVER_ENCRYPT=true
# SQLSERVER_TRUST_CERT=true

# Local development (SQL Server Express)
# SQLSERVER_HOST=localhost\\SQLEXPRESS
# SQLSERVER_ENCRYPT=false
# SQLSERVER_TRUST_CERT=true

# Multiple connections (optional)
# Register additional named connections via JSON. Each entry accepts the same
# fields as the default connection (server/host, user, password, database,
# port, encrypt, trustServerCertificate, authMode, etc.). Tools accept an
# optional "connection" argument to target one of these by name; the
# list_connections tool reports the configured names.
# SQLSERVER_CONNECTIONS={"warehouse":{"host":"warehouse.example.com","user":"reader","password":"secret","database":"DataWarehouse"},"reporting":{"host":"reporting.example.com","user":"reader","password":"secret","database":"Reports"}}
# SQLSERVER_DEFAULT_CONNECTION=default